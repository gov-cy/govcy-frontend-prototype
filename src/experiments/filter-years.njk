---js
{
  title: "Yearly social insurance statements",
    "pageData": {
        "title": {"en": "Yearly social insurance statements", "el": "Ετήσιες δηλώσεις κοινωνικής ασφάλισης"},
        "layout": "layouts/govcyBase.njk",
        "mainLayout": "max-width"
    },
    "site": {
        "lang": "en",
        "title" : {"en":"Experiments", "el":"Experiments"}, 
        "headerTitle" : {"en":"Yearly social insurance statements", "el":"Ετήσιες δηλώσεις κοινωνικής ασφάλισης"},
        "description" : {"en":"Yearly social insurance statements", "el":"Ετήσιες δηλώσεις κοινωνικής ασφάλισης"},
        "isTesting" : true,
        "url": "https://gov.cy",
        "cdn": {
            "dist": "https://cdn.jsdelivr.net/gh/gov-cy/govcy-design-system@3.3.0/dist"
        }   
    }
}
---

{% extends '../../node_modules/@gov-cy/govcy-frontend-renderer/src/njk/layouts/govcyBase.njk' %}
{% from "../../node_modules/@gov-cy/govcy-frontend-renderer/src/njk/govcyElement.njk" import govcyElement %}

{% block userName %}
{{ 
    govcyElement(
        "userName",
        {
            "name":{"en":"George Smith","el":"Γιώργος Σμιθ"}
            ,"signOutLink":"#"
        }
    ) 
}}
{% endblock %}
{% block beforeMain %}
{{ 
    govcyElement(
        "backLink",
        {text:{en:"Back",el:"Πίσω"} ,href:"#"}
    ) 
}}
{% endblock %}
{% block main %}
<style>
    [hidden] { display: none !important; }
    .year-options { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 12px; }
    /* Keeps action buttons semantic while allowing the UDS link treatment. */
    .govcy-link-button { background: transparent; border: 0; padding: 0; font: inherit; cursor: pointer; }
    @media (max-width: 767px) { .year-options { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @media (max-width: 575px) { .year-options { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
<div class="govcy-alert-error govcy-br-5 govcy-br-danger govcy-p-3" id="error-summary" hidden>
    <h2 role="alert" id="error-heading" tabindex="-1">There is a problem</h2>
    <p class="govcy-mb-0" id="error-links"></p>
</div>
<h1>Yearly social insurance statements</h1>
<div class="govcy-form govcy-search-form">
    <h2 class="govcy-pt-0">Filter by year</h2>
    <p>Select a range, individual years, or both.</p>
    <form class="govcy-form" id="year-filter" novalidate>
        <fieldset class="govcy-fieldset" aria-describedby="range-hint available-years">
        <legend class="govcy-legend">Select a range</legend>
        <div class="govcy-form-control">
            <p class="govcy-hint" id="range-hint">Includes both years. Selecting a range replaces your current selection.</p>
            <div class="govcy-d-flex govcy-flex-wrap govcy-align-items-end">
            <div class="govcy-form-control govcy-mr-6 govcy-mb-4" id="from-control">
                <label class="govcy-label govcy-label-primary" for="from-year">From year</label>
                <p class="govcy-input-error-msg" id="from-year-error" hidden><span class="govcy-visually-hidden-error">Error:</span><span class="error-message"></span></p>
                <input id="from-year" class="govcy-text-input govcy-text-input-char_4" type="text" spellcheck="false" inputmode="numeric" pattern="[0-9]*" value="2000" aria-describedby="range-hint available-years">
            </div>
            <div class="govcy-form-control govcy-mb-4" id="to-control">
                <label class="govcy-label govcy-label-primary" for="to-year">To year</label>
                <p class="govcy-input-error-msg" id="to-year-error" hidden><span class="govcy-visually-hidden-error">Error:</span><span class="error-message"></span></p>
                <input id="to-year" class="govcy-text-input govcy-text-input-char_4" type="text" spellcheck="false" inputmode="numeric" pattern="[0-9]*" value="2024" aria-describedby="range-hint available-years">
            </div>
            <div class="govcy-ml-4 govcy-mb-4">
                <button class="govcy-btn-secondary govcy-mb-0" id="select-range" type="button">Select range</button>
            </div>
            </div>
            <p class="govcy-hint" id="available-years">Available years: 1987 to 2026</p>
        </div>
        </fieldset>
        <div class="govcy-inset-text govcy-mb-6" role="status" aria-live="polite" aria-atomic="true">
        <p class="govcy-mb-2 govcy-label-primary"><strong id="selected-count">23 years selected</strong></p>
        <p class="govcy-mb-0" id="selected-summary">2000–2024, excluding 2008 and 2012</p>
        </div>
        <details class="govcy-details" id="individual-years">
        <summary class="govcy-details__summary"><span class="govcy-details__summary-text">Choose or adjust individual years</span></summary>
        <div class="govcy-details__text">
            <fieldset class="govcy-fieldset" aria-describedby="individual-hint">
            <legend class="govcy-legend">Individual years</legend>
            <div class="govcy-form-control govcy-mb-0">
                <p class="govcy-hint" id="individual-hint">Tick years to include them. Untick years to exclude them.</p>
                <button class="govcy-link govcy-link-button govcy-mb-6" id="select-all" type="button">Select all 40 years</button>
                <div class="year-options" id="year-options"></div>
            </div>
            </fieldset>
        </div>
        </details>
        <div class="govcy-d-flex govcy-flex-wrap govcy-align-items-center">
        <button class="govcy-btn-secondary govcy-mr-6" id="apply-filters" type="button">Update results</button>
        <button class="govcy-link govcy-link-button" id="clear-selection" type="button">Clear selection</button>
        </div>
    </form>
</div>
<h2 class="govcy-pt-0">Your statements</h2>
<div role="status" aria-live="polite" aria-atomic="true"><p id="applied-summary" hidden></p></div>
<div class="govcy-warning-text">
    <span class="govcy-warning-text-icon" aria-hidden="true">!</span>
    <span class="govcy-warning-text-message">
        <span class="govcy-visually-hidden">Warning:</span>
        The table's data are not refreshed based on the filter in this prototype.</span>
</div>
<table class="govcy-table govcy-table-responsive-vertical">
    <thead>
        <tr>
            <th>Year</th>
            <th>Statement</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>
                <div class="govcy-d-md-none govcy-fw-bolder govcy-my-2">Year</div>
                2010
            </td>
            <td>
                <div class="govcy-d-md-none govcy-fw-bolder govcy-my-2">Statement</div>
                Statement 1
            </td>
        </tr>
        <tr>
            <td>
                <div class="govcy-d-md-none govcy-fw-bolder govcy-my-2">Year</div>
                2011
            </td>
            <td>
                <div class="govcy-d-md-none govcy-fw-bolder govcy-my-2">Statement</div>
                Statement 2
            </td>
        </tr>
        <tr>
            <td>
                <div class="govcy-d-md-none govcy-fw-bolder govcy-my-2">Year</div>
                2012
            </td>
            <td>
                <div class="govcy-d-md-none govcy-fw-bolder govcy-my-2">Statement</div>
                Statement 3
            </td>
        </tr>
    </tbody>
</table>
<button class="govcy-btn-primary" type="button">Continue</button>
<script>
  (() => {
    const byId = id => document.getElementById(id);
    const years = Array.from({length: 40}, (_, i) => 1987 + i);
    let selected = new Set(years.filter(y => y >= 2000 && y <= 2024 && y !== 2008 && y !== 2012));
    let applied = null;
    const boxes = new Map();
    years.forEach(year => {
      const row = document.createElement('div'); row.className = 'govcy-checkbox';
      const input = document.createElement('input'); input.className = 'govcy-checkbox-input';
      input.type = 'checkbox'; input.id = 'year-' + year; input.name = 'years'; input.value = String(year);
      const label = document.createElement('label'); label.className = 'govcy-label'; label.htmlFor = input.id; label.textContent = year;
      row.append(input, label); byId('year-options').append(row); boxes.set(year, input);
      input.addEventListener('change', () => { input.checked ? selected.add(year) : selected.delete(year); render(); });
    });
    function join(items) { return items.length < 3 ? items.join(' and ') : items.slice(0, -1).join(', ') + ', and ' + items[items.length - 1]; }
    function describe(values) {
      if (!values.length) return 'No years selected. Apply to show all years.';
      if (values.length === 1) return String(values[0]);
      const first = values[0], last = values[values.length - 1];
      const gaps = years.filter(y => y >= first && y <= last && !values.includes(y));
      if (gaps.length <= 3) return first + '–' + last + (gaps.length ? ', excluding ' + join(gaps) : '');
      const groups = []; let a = first, b = first;
      for (const y of values.slice(1)) { if (y === b + 1) b = y; else { groups.push(a === b ? String(a) : a + '–' + b); a = b = y; } }
      groups.push(a === b ? String(a) : a + '–' + b); return join(groups);
    }
    function render() {
      const values = [...selected].sort((a,b) => a-b);
      boxes.forEach((input, year) => { input.checked = selected.has(year); });
      byId('selected-count').textContent = values.length + (values.length === 1 ? ' year selected' : ' years selected');
      byId('selected-summary').textContent = describe(values);
      byId('applied-summary').hidden = applied === null;
      if (applied !== null) byId('applied-summary').textContent = JSON.stringify(values) === JSON.stringify(applied)
        ? (applied.length ? 'Filter applied: ' + describe(applied) + '.' : 'Filter applied: showing all years.')
        : 'Selection changed. Choose Update results to update the results.';
    }
    function clearErrors() {
      byId('error-summary').hidden = true; byId('error-links').replaceChildren();
      for (const key of ['from', 'to']) {
        byId(key + '-control').classList.remove('govcy-form-control-error');
        const input = byId(key + '-year'); input.classList.remove('govcy-text-input-error'); input.removeAttribute('aria-invalid');
        input.setAttribute('aria-describedby', 'range-hint available-years'); byId(key + '-year-error').hidden = true;
      }
    }
    function validateRange() {
      clearErrors(); const errors = [];
      const from = byId('from-year').value.trim(), to = byId('to-year').value.trim();
      for (const [key, value] of [['from', from], ['to', to]]) {
        if (!/^\d{4}$/.test(value) || Number(value) < 1987 || Number(value) > 2026) errors.push([key, 'Enter a ' + (key === 'from' ? 'From' : 'To') + ' year between 1987 and 2026.']);
      }
      if (!errors.length && Number(from) > Number(to)) errors.push(['to', 'To year must be the same as or after From year.']);
      if (errors.length) {
        for (const [key, message] of errors) {
          byId(key + '-control').classList.add('govcy-form-control-error');
          const input = byId(key + '-year'); input.classList.add('govcy-text-input-error'); input.setAttribute('aria-invalid', 'true');
          input.setAttribute('aria-describedby', 'range-hint available-years ' + key + '-year-error');
          const error = byId(key + '-year-error'); error.querySelector('.error-message').textContent = message; error.hidden = false;
          const link = document.createElement('a'); link.href = '#' + input.id; link.textContent = message; link.className = 'govcy-d-block';
          link.addEventListener('click', event => { event.preventDefault(); input.focus(); input.scrollIntoView({block:'center'}); }); byId('error-links').append(link);
        }
        byId('error-summary').hidden = false; byId('error-heading').focus(); byId('error-summary').scrollIntoView({block:'start'}); return null;
      }
      return [Number(from), Number(to)];
    }
    function selectRange() {
      const range = validateRange(); if (!range) return;
      selected = new Set(years.filter(y => y >= range[0] && y <= range[1])); render();
    }
    byId('select-range').addEventListener('click', selectRange);
    byId('apply-filters').addEventListener('click', () => { clearErrors(); applied = [...selected].sort((a,b) => a-b); render(); });
    byId('year-filter').addEventListener('submit', event => event.preventDefault());
    for (const id of ['from-year', 'to-year']) byId(id).addEventListener('keydown', event => { if (event.key === 'Enter') { event.preventDefault(); selectRange(); } });
    byId('select-all').addEventListener('click', () => { selected = new Set(years); render(); });
    byId('clear-selection').addEventListener('click', () => { selected.clear(); byId('from-year').value = ''; byId('to-year').value = ''; clearErrors(); render(); });
    function reportHeight() { parent.postMessage({type:'year-filter-height', height:document.body.scrollHeight}, '*'); }
    new ResizeObserver(reportHeight).observe(document.body);
    window.addEventListener('load', reportHeight);
    render(); reportHeight();
  })();
  </script>
{% endblock %}